# Copia este archivo a .env y pega tus llaves.
# Solo necesitas UNA de las de LLM/STT para empezar.
# TTS funciona sin llave (Edge).

# --- Groq (recomendado para voz: Whisper ultra rápido) ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Google Gemini (recomendado para razonar + cámara) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- NVIDIA NIM (opcional, respaldo LLM gratis) ---
# https://build.nvidia.com
NVIDIA_API_KEY=

# --- OpenRouter modelos :free (opcional) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- xAI (opcional, si más adelante pagas API) ---
XAI_API_KEY=
